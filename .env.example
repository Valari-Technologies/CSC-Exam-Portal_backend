SECRET_KEY=change-me-to-a-long-random-string-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Docker PostgreSQL only. Host runs use localhost:15432 (the Docker container's
# published port); 15432 (not 5432) guarantees you never hit native Windows Postgres.
# 15432 also avoids the Windows winnat reserved range 5433-5532.
DATABASE_URL=postgresql://postgres:vetrivinayagar@localhost:15432/csc_exam_portal
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Sign in with Google (OAuth 2.0) ---
# Create an OAuth 2.0 Client ID of type "Web application" in Google Cloud Console
# (APIs & Services -> Credentials), then add your app's origin (e.g. http://localhost:5173)
# under "Authorised JavaScript origins".
# GOOGLE_CLIENT_ID is the token AUDIENCE and MUST match the frontend's VITE_GOOGLE_CLIENT_ID.
# While it is blank, /auth/google/ refuses every sign-in (fails closed) — it cannot verify
# that an id_token was minted for this application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MAX_UPLOAD_SIZE_MB=2
